{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tocky Voice",
  "version": "0.5.1",
  "identifier": "pro.mecode.tockyvoice",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "Tocky Voice",
        "width": 960,
        "height": 720,
        "minWidth": 720,
        "minHeight": 560,
        "visible": true,
        "resizable": true
      },
      {
        "label": "overlay",
        "create": false,
        "title": "Recording",
        "width": 518,
        "height": 250,
        "visible": false,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": false,
        "focus": false,
        "acceptFirstMouse": true
      },
      {
        "label": "player",
        "create": false,
        "title": "Read aloud",
        "width": 502,
        "height": 150,
        "visible": false,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": false,
        "focus": false,
        "acceptFirstMouse": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; media-src 'self' https://raw.githubusercontent.com; connect-src 'self' ipc: http://ipc.localhost; frame-src 'none'; object-src 'none'; base-uri 'none'; form-action 'none'",
      "freezePrototype": true
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0",
      "entitlements": "entitlements.plist"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDI0QTM1ODA3NTQyQkYyN0UKUldSKzhpdFVCMWlqSkV1ZnptNEdXbG1wczc4Y3VzS280bnN6QTZuc2ZSbi9ZTzVSbGFRMTRWbXMK",
      "endpoints": [
        "https://github.com/dangngocbinh/tocky-voice/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
